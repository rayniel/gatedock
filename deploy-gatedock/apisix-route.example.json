{
  "name": "gatedock",
  "host": "gatedock.example.com",
  "uri": "/*",
  "enable_websocket": true,
  "upstream": {
    "type": "roundrobin",
    "pass_host": "pass",
    "nodes": {
      "127.0.0.1:8666": 1
    },
    "timeout": {
      "connect": 60,
      "send": 7200,
      "read": 7200
    }
  }
}
