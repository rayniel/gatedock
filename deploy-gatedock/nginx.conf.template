map $http_upgrade $gatedock_connection {
    default upgrade;
    '' close;
}

geo $realip_remote_addr $gatedock_trusted_proxy {
    default 0;
    ${GATEDOCK_TRUSTED_PROXY_CIDR} 1;
}

map "$gatedock_trusted_proxy:$http_x_forwarded_proto" $gatedock_external_scheme {
    default $scheme;
    "1:https" https;
    "1:http" http;
}

server {
    listen 80;
    include /etc/nginx/snippets/gatedock-web-login.conf;
    set_real_ip_from ${GATEDOCK_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /etc/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript application/json;
    client_max_body_size 10240m;
    client_body_timeout 1800s;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $gatedock_external_scheme;
    proxy_set_header X-Scheme $gatedock_external_scheme;
    proxy_set_header X-Script-Name "";
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $gatedock_connection;
    proxy_redirect off;
    proxy_connect_timeout 60s;
    proxy_read_timeout 7200s;
    proxy_send_timeout 7200s;
    proxy_request_buffering off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ^~ /api/oneterm {
        proxy_pass http://${ONETERM_API_HOST};
        proxy_buffering off;
    }

    location ^~ /api/ {
        proxy_pass http://${ACL_API_HOST};
    }

    location ~* \.(css|js)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }
}
